{
  "name": "pnewmo",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "bootstrap": "node scripts/bootstrap.mjs && pnpm install && pnpm db:generate",
    "dev": "pnpm db:up && pnpm db:sync && pnpm db:seed && turbo run dev mock",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose stop postgres",
    "db:reset": "docker compose down -v && pnpm db:up",
    "db:sync": "pnpm --filter @pnewmo/api db:deploy && pnpm --filter @pnewmo/api db:generate",
    "db:psql": "docker compose exec postgres psql -U pnewmo -d pnewmo",
    "db:generate": "pnpm --filter @pnewmo/api db:generate",
    "db:migrate": "pnpm --filter @pnewmo/api db:migrate",
    "db:seed": "pnpm --filter @pnewmo/api db:seed",
    "db:seed:reset": "pnpm --filter @pnewmo/api db:seed:reset",
    "db:studio": "pnpm --filter @pnewmo/api db:studio",
    "db:test:setup": "pnpm --filter @pnewmo/api db:test:setup && pnpm --filter @pnewmo/api db:test:migrate"
  },
  "devDependencies": {
    "prettier": "3.8.3",
    "turbo": "2.10.9",
    "typescript": "^5.9.3"
  }
}
